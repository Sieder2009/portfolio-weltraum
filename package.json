{
  "name": "space-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio von Thomas Johann Sieder als interaktives Sonnensystem.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
