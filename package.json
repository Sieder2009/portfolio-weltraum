    "@fontsource-variable/unbounded": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
